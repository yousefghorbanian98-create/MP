# Never send repository credentials, user data, backups, or local environments to the daemon.
.git
**/.git
.venv
**/.venv
.env
**/.env
**/.env.*
**/*.db
**/*.sqlite
**/*.sqlite3
**/backups
**/mp-backups

# Build cache / generated frontend and test artifacts.
**/node_modules
**/dist
**/coverage
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/tests
**/test-results

# Repository-only material not copied by production Dockerfiles.
.claude
.finn
.github
.semgrep
evidence
finn
docs
mp-app/client
mp-app/deploy
mp-app/infra/ansible
mp-app/infra/monitoring
