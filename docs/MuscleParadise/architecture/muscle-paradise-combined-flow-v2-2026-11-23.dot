    waitlist_available [shape=diamond, label="رزرو waitlisted\nوجود دارد؟", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", margin="0.12,0.05"];
    waitlist_promote [label="نفر اول FIFO → confirmed", color="#6CAAF8"];
    cancel_no_promotion [label="لغو waitlisted / بدون جا\nیا صف خالی → بدون ارتقا", color="#6CAAF8"];
    qr_checkin [label="QR یک‌بارمصرف حضور\nاعتبارسنجی → CheckIn", color="#51D6C2", fillcolor="#142B32"];
    biometric [label="Face check-in غیرفعال\nبدون probe/liveness معتبر؛ method=face → 409\nمسیر حضور فعال: QR امضاشده", color="#FF7887", fillcolor="#301B2A", fontcolor="#FFE8EC"];
    shop_switch [shape=diamond, label="Shop online فعال؟\nپیش‌فرض خیر", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", margin="0.12,0.05"];
    shop_denied [label="خاموش: fail closed\nCheckout رد می‌شود", color="#FF7887", fillcolor="#301B2A", fontcolor="#FFE8EC"];
    wallet_check [shape=diamond, label="در مسیر wallet\nموجودی کافی؟", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", margin="0.12,0.05"];
    no_side_effects [label="ناموفق: بدون order/payment/debit؛\nstock و balance ثابت؛ cart باقی", color="#6CAAF8"];
    atomic_checkout [label="موفق: Order + Payment paid + debit\n+ stock/cart در commit اتمیک", color="#6CAAF8"];
    refund_access [shape=diamond, label="Manager/admin + finance.write\nیا super_admin؟", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", margin="0.12,0.05"];
    refund_deny [label="پذیرش / بدون grant → 403", color="#FF7887", fillcolor="#301B2A", fontcolor="#FFE8EC"];
    refund_audit [label="Refund + AuditLog(actor)\nدر یک commit؛ sandbox تستی", color="#6CAAF8"];
    staff_admin [label="Studio ops\nKPI / finance reports / Expense+receipt\nshop admin / campaign / feature flags", color="#6CAAF8"];
    comms_jobs [label="Notification / Outbox / Chat\nScheduler و SMS وابسته به runtime", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE"];
  }

  subgraph cluster_backend_data {
    label="۷ · Backend، ذخیره‌سازی و اتصال‌ها"; color="#51D6C2"; fontcolor="#51D6C2"; style="rounded"; penwidth=1.4;
    routers [label="FastAPI routers + Pydantic schemas", color="#B99AFB", fillcolor="#211D39"];
    services [label="Modular-monolith services\nauth · membership · programs/assessment\nnutrition · classes/face_id · payments/shop\nexpenses/reports/admin · notify/chat/privacy", color="#B99AFB", fillcolor="#211D39"];
    database [label="SQLAlchemy → SQLite (default config)\nMembers · plans · assessments · payments/ledger\nclasses/check-ins · shop/orders · nutrition\naudit/consent · notifications/messages", color="#51D6C2", fillcolor="#142B32"];
    private_store [label="رسید/فایل خصوصی\nخارج از static; access کنترل‌شده", color="#51D6C2", fillcolor="#142B32"];
    optional_services [label="Valkey/cache · APScheduler\nSMS · payment gateway · Ollama text\nهمه وابسته به تنظیم/اثبات runtime", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE"];
    source_stores [label="Source registries جدا\nlocal/private data + approved catalog\npublic/external data وارد DB نشده", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
  }

