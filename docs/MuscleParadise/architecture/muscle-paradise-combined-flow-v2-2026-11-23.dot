digraph MuscleParadiseCombinedFlowV2 {
  graph [
    rankdir=TB, bgcolor="#0B1220", pad="0.38", nodesep="0.25", ranksep="0.58",
    splines=ortho, compound=true, newrank=true, dpi=180,
    fontname="DejaVu Sans", fontsize=25, fontcolor="#EEF4FC",
    label="نقشهٔ یکپارچهٔ کل برنامهٔ Muscle Paradise\nمسیرهای موجود عضو و کادر + چرخهٔ طراحی‌شدهٔ برنامهٔ تمرین + داده، تراکنش، Backend و اتصال‌ها",
    labelloc="t", labeljust="c"
  ];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=14,
        color="#49627D", fillcolor="#15243A", fontcolor="#EEF4FC",
        penwidth=1.2, margin="0.15,0.10"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#8296AD", fontcolor="#DCE6F1",
        penwidth=1.0, arrowsize=0.62];

  subgraph cluster_legend {
    label="راهنما"; color="#52657A"; fontcolor="#C6D2DF"; style="rounded,dashed";
    l_code [label="کد/ماژول موجود", color="#51D6C2", fillcolor="#142B32"];
    l_test [label="سناریوی آزموده‌شده در محیط توسعه", color="#6CAAF8", fillcolor="#17283D"];
    l_target [label="طرح پیشنهادی؛ هنوز runtime نیست", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    l_gap [label="گیر/شکاف یا stop فعلی", color="#FF7887", fillcolor="#301B2A", fontcolor="#FFE8EC"];
  }

  subgraph cluster_people_clients {
    label="۱ · نقش‌ها و رابط‌های برنامه"; color="#6CAAF8"; fontcolor="#6CAAF8"; style="rounded"; penwidth=1.4;
    member [label="عضو / ورزشکار", color="#6CAAF8"];
    coach [label="مربی", color="#6CAAF8"];
    reception [label="پذیرش", color="#6CAAF8"];
    manager [label="مدیر / مدیرکل", color="#6CAAF8"];
    kiosk [label="کیوسک / اسکنر QR", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE"];
    flutter [label="MP Client · Flutter\nاپ عضو", color="#6CAAF8"];
    studio [label="MP Studio · React / TypeScript\nپنل وب کادر", color="#6CAAF8"];
    gate_ui [label="رابط حضور در باشگاه\nQR فعال؛ چک‌این چهره غیرفعال", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE"];
  }

  subgraph cluster_api_access {
    label="۲ · API، ورود و مجوز"; color="#FFC56E"; fontcolor="#FFC56E"; style="rounded"; penwidth=1.4;
    api [label="FastAPI REST `/api/v1`\nrouter → service → database", color="#B99AFB", fillcolor="#211D39"];
    otp [label="OTP request / verify\nAccess + Refresh token", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE"];
    guard [label="CurrentUser / Bearer\nrequire_roles + permission/grant\nowner / member scope", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE"];
    auth_deny [label="رد درخواست\n401 / 403", color="#FF7887", fillcolor="#301B2A", fontcolor="#FFE8EC"];
  }

  subgraph cluster_member_runtime {
    label="۳ · تجربه و سرویس‌های موجود عضو"; color="#6CAAF8"; fontcolor="#6CAAF8"; style="rounded"; penwidth=1.4;
    profile_member [label="پروفایل / اشتراک\nMember · Membership", color="#51D6C2", fillcolor="#142B32"];
    member_assess [label="ارزیابی و پیشرفت\nAxis · Field Test · JP7 raw", color="#51D6C2", fillcolor="#142B32"];
    nutrition_now [label="تغذیهٔ فعلی\nکالری/ماکرو به شکل draft؛\nmeals خالی؛ FoodLog جدا", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE"];
    classes_flow [label="کلاس‌ها\nظرفیت → رزرو/صف → لغو\nrebook همان ردیف با زمان تازه", color="#6CAAF8"];
    attendance_flow [label="حضور QR\nتوکن → اسکن → CheckIn\nQR حضور ≠ QR برنامه", color="#6CAAF8"];
    payment_flow [label="کیف‌پول / پرداخت / رسید\nنقدی و بازبینی انسانی\nدرگاه وابسته به تنظیم", color="#51D6C2", fillcolor="#142B32"];
    shop_flow [label="فروشگاه\nکاتالوگ → سبد → checkout\nخرید آنلاین پیش‌فرض خاموش", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE"];
    comms_flow [label="اعلان و گفت‌وگو\nInbox · Outbox · Chat", color="#51D6C2", fillcolor="#142B32"];
    today_gap [label="شکاف UI امروز\nروز/هفته محدود؛ تیک انجام تمرین\nدر مسیر مرورشده فقط محلی است", color="#FF7887", fillcolor="#301B2A", fontcolor="#FFE8EC"];
  }

  subgraph cluster_current_training {
    label="۴ · برنامهٔ تمرین: مسیر فعلی کد"; color="#B99AFB"; fontcolor="#B99AFB"; style="rounded"; penwidth=1.4;
    intake [label="فرم Intake عضو\nهدف · سطح · تعداد روز · قیدها", color="#6CAAF8"];
    gate_check [label="`POST /population/gate-check`\nJSON body: `GateCheckIn(path)`", color="#B99AFB", fillcolor="#211D39"];
    gate_contract [label="قرارداد Flutter/backend همسو\nTestClient: body {path} → 200 (adult)", color="#6CAAF8"];
    population_hold [label="مسیر ناشناخته/غیرفعال\nتوقف خودکار (E05)", color="#FF7887", fillcolor="#301B2A", fontcolor="#FFE8EC"];
    direct_api [label="`POST /ai/program/generate`\nمسیر مصرف‌شده از Intake؛ خروجی قواعد\nپیش‌نویس (نیازمند تأیید کادر)", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE"];
    rule_engine [label="موتور قطعی قواعد فعلی\ngoal / level / days / weeks / constraints\nExercise ID + pattern", color="#B99AFB", fillcolor="#211D39"];
    safety_map [label="exercise_id + pattern → taxonomy ایمنی\nنگاشت کاتالوگ؛ شناسهٔ ناشناخته = بازبینی", color="#6CAAF8"];
    safety [shape=diamond, label="Safety flags\nclear / unknown / blocked", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", margin="0.12,0.05"];
    safety_gap [label="گپ مصرفی باقی‌مانده\nblocked/unknown هنوز draft می‌شود؛\nIntake نتیجه را پیش از تأیید نمایش می‌دهد", color="#FF7887", fillcolor="#301B2A", fontcolor="#FFE8EC"];
    draft_now [label="ذخیرهٔ WorkoutProgram\nWeek → Exercise؛ status=draft", color="#51D6C2", fillcolor="#142B32"];
    coach_queue [label="Studio: صف approve / reject\nممیزی تغییر وضعیت", color="#6CAAF8"];
    approve_now [shape=diamond, label="مربی تأیید می‌کند؟", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", margin="0.12,0.05"];
    publish_now [label="نمایش / نسخهٔ تأییدشده\nفیلتر وضعیت و نام حرکت نیازمند تکمیل", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE"];
  }

  subgraph cluster_future_program_cycle {
    label="۵ · چرخهٔ یکپارچهٔ آیندهٔ ورزشکار و برنامه (طرح؛ نه قابلیت runtime)";
    color="#FFC56E"; fontcolor="#FFC56E"; style="rounded,dashed"; penwidth=1.4;
    athlete_form [label="Q01–Q11 عضو + C01–C11 مربی\nهدف · زمان/تجهیزات · سابقه · سنجش · ریسک\nپاسخ unknown و منبع/تاریخ حفظ شود", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    consent_gate [shape=diamond, label="هویت، رضایت، scope\nو داده معتبر؟", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled", margin="0.12,0.05"];
    hold [label="STOP / بازبینی مربی\nپاسخ ناقص، تعارض، red flag،\nمحدودیت/جمعیت نامعلوم", color="#FF7887", fillcolor="#301B2A", fontcolor="#FFE8EC", style="rounded,dashed,filled"];
    question_router [label="Question Router\nهر سؤال → DB خصوصی / منبع مستقل\nشناسه، نسخه، provenance", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    private_data [label="دادهٔ خصوصی عضو\nProfile / Assessment / ProgramVersion\nlogs و اندازه‌گیری‌ها", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    source_registry [label="Source Registry\nکاتالوگ حرکت · evidence · calculator\nهر source_id/namespace جدا", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    source_gate [label="License / schema / quality\nو approval gate", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    approved_catalog [label="ExerciseCatalog approved\nحرکت canonical + gear + skill\nvariant و رسانه با provenance", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    load_evidence [label="Versioned rules + training-load\nOpenAthlete/library/evidence\nفقط روی دادهٔ مجاز همان فرد", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    nutrition_separate [label="Nutrition namespace جدا\nFood / Meal / Allergy / Logs\nبه planner تمرین قاطی نشود", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    compose [label="ProgramComposer\nقید سخت + هدف + تجهیزات + ریکاوری\nهر انتخاب با reason/source/version", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    future_safety [shape=diamond, label="گیت ایمنی نسخه‌دار\nclear؟", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled", margin="0.12,0.05"];
    future_review [label="C11 مربی\nبازبینی / تغییر با دلیل / امضا", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    version [label="ApprovedProgramVersion\nimmutable + content hash\nیک ID برای اپ و PDF", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    pdf_qr [label="PDF کامل خصوصی\nQR یکتا فقط صفحهٔ آخر\nQR resolve می‌کند؛ PDF داخل QR نیست", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    member_cycle [label="اپ عضو / اجرای جلسه\nلاگ planned vs performed\nست، بار، effort، adherence", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    compare [shape=diamond, label="سنجش/لاگ قابل‌مقایسه\nو کافی است؟", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled", margin="0.12,0.05"];
    scorecards [label="روند/scorecard هر جزء\nفقط metric معتبر؛ JP7 خام\n≠ رشد موضعی عضله", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    next_version [label="چرخهٔ بعد n+1\nنسخهٔ قبلی حفظ می‌شود", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    jp7_raw [label="JP7/C02: مربی raw readings\nmm + site + protocol + کیفیت", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    jp7_gate [shape=diamond, label="site / equation / جمعیت\nو consent approved؟", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled", margin="0.12,0.05"];
    jp7_compute [label="پس از approval: محاسبهٔ نسخه‌دار\nمشتق و تاریخچهٔ جدا از raw", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    jp7_locked [label="کد فعلی: مشتق JP7 قفل\n`calf`/`midaxillary` mismatch؛\nفعلاً خام فقط", color="#FF7887", fillcolor="#301B2A", fontcolor="#FFE8EC", style="rounded,dashed,filled"];
    qr_native [label="QR برنامهٔ داخلی\nlogin + owner check → resolve ProgramVersion\nبدون OCR", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    pdf_import [label="PDF بیرونی/قدیمی\nprivate upload + hash → text extraction\nOCR فقط صفحهٔ اسکن‌شده → ImportCandidate", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
    coach_import [label="مربی فایل/حرکت/دوز را تأیید کند\nLegacyProgramVersion immutable", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", style="rounded,dashed,filled"];
  }

  subgraph cluster_club_money {
    label="۶ · گردش‌های عملیاتی باشگاه و تراکنش‌ها"; color="#B99AFB"; fontcolor="#B99AFB"; style="rounded"; penwidth=1.4;
    membership [label="ثبت عضو / تمدید\nPayment → Membership", color="#51D6C2", fillcolor="#142B32"];
    class_capacity [shape=diamond, label="ظرفیت کلاس\nجا دارد؟", color="#FFC56E", fillcolor="#30271A", fontcolor="#FFF0CE", margin="0.12,0.05"];
