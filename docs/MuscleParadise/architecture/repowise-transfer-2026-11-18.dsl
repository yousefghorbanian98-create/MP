# Structurizr DSL model for mirror, generated by Repowise.
#
# A complete workspace: open it as-is in Structurizr Lite, the
# Structurizr CLI, or by pasting it into structurizr.com.
#
# This file is yours now — edit the views and styles below freely.
# Re-exporting overwrites the whole file, so once you have made it
# your own, switch to the model fragment instead and keep your
# presentation in a workspace.dsl the generator never touches:
#
#     repowise export --format structurizr
#
# Suggested reading order:
#   1. README.md — README.md
#      Start here for the end-to-end picture before diving into the code.
#   2. main.cjs — mp-app/studio/electron/main.cjs
#      An entry point — execution and imports fan out from here.
#   3. main.py — mp-app/backend/app/main.py
#      An entry point — execution and imports fan out from here.
#   4. App.tsx — mp-app/studio/src/App.tsx
#      An entry point — execution and imports fan out from here.
#   5. main.tsx — mp-app/studio/src/main.tsx
#      An entry point — execution and imports fan out from here.
#   6. main.dart — mp-app/client/lib/main.dart
#      An entry point — execution and imports fan out from here.
#   7. docs_gate.py — scripts/docs_gate.py
#      The Docs & Tooling layer's anchor — its most depended-on file.
#   8. base.py — mp-app/backend/db/base.py
#      Directly used by the entry points above; a core collaborator.
#   9. glass_card.dart — mp-app/client/lib/shared/widgets/glass_card.dart
#      The Utility layer's anchor — its most depended-on file.
#   10. api.py — mp-app/backend/api/v1/api.py
#      The API layer's anchor — its most depended-on file.
#   11. Sidebar.tsx — mp-app/studio/src/components/Sidebar.tsx
#      The UI layer's anchor — its most depended-on file.
#   12. conftest.py — mp-app/backend/tests/conftest.py
#      The test suite — how the system's behavior is verified.
#
workspace "mirror" {
