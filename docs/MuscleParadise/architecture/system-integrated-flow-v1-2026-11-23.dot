  svc_comms -> runtime_jobs [style=dashed, color="#E9B85C"];

  subgraph cluster_integrations {
    label="۷ · سرویس پیرامونی و عملیات؛ پیکربندی/استقرار تعیین‌کننده است"; color="#6AB7E8"; fontcolor="#8CCCF0"; style="rounded";
    sms [label="SMS provider\nپیش‌فرض dev؛ provider واقعی به secret/config نیاز دارد", color="#E9B85C", fillcolor="#2A2418", fontcolor="#FFE9B9"];
    bank [label="منبع بانکی مستقل / تأیید انسانی\nتصویر فیش ≠ اثبات واریز؛ gateway زنده فرض نشده", color="#E9B85C", fillcolor="#2A2418", fontcolor="#FFE9B9"];
    ai_optional [label="Ollama / AI اختیاری\nمسیر runtime وابسته به config؛ مرجع safety نیست", color="#E9B85C", fillcolor="#2A2418", fontcolor="#FFE9B9"];
    operations [label="عملیات و مشاهده‌پذیری\nhealth · metrics · proxy/Compose\nproduction/restore/device E2E اثبات نشده", color="#6AB7E8", fillcolor="#172739"];
    { rank=same; sms; bank; ai_optional; operations; }
    sms -> bank -> ai_optional -> operations [style=invis, weight=20];
