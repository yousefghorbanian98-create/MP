  subgraph cluster_data {
    label="۶ · مدل‌های پایدار/فایل؛ نقشهٔ مفهومی است نه ERD کامل"; color="#51D6A0"; fontcolor="#51D6A0"; style="rounded";
    data_identity [label="User · OtpCode · RefreshToken\nPhoneChangeChallenge · AdminPermission\nMember · Membership", color="#51D6A0", fillcolor="#132B22"];
    data_training [label="WorkoutProgram → ProgramWeek\n→ ProgramExercise · Exercise · SetFeedback", color="#51D6A0", fillcolor="#132B22"];
    data_assessment [label="AxisAssessment/Score · FieldTestResult\nJacksonPollockMeasurement (دادهٔ خام)", color="#51D6A0", fillcolor="#132B22"];
