  role_target -> authz_gate [style=dashed, color="#E9B85C", label="policy/gap؛ نه route migration کامل", constraint=false];

  subgraph cluster_future_program {
    label="هدف آیندهٔ برنامه‌ساز / source routing / PDF؛ تمام این زنجیره طرح است"; color="#E9B85C"; fontcolor="#FFE2A3"; style="rounded,dashed";
    q_forms [label="Q01–Q11 عضو + C01–C11 مربی\nsource/date/unknown/consent\nsnapshot ورودی نسخه‌دار", color="#E9B85C", fillcolor="#2A2418", fontcolor="#FFE9B9", style="rounded,dashed,filled"];
    source_gate [label="Question Router → Source Registry\nمجوز · schema · کیفیت · provenance\nفقط source تأییدشده به planner", color="#E9B85C", fillcolor="#2A2418", fontcolor="#FFE9B9", style="rounded,dashed,filled"];
    composer [label="ProgramComposer + safety gate\nهدف/تجهیزات/مهارت/ریکاوری/شواهد\nunknown/red flag → stop یا بازبینی مربی", color="#E9B85C", fillcolor="#2A2418", fontcolor="#FFE9B9", style="rounded,dashed,filled"];
    versioned_program [label="ApprovedProgramVersion تغییرناپذیر\nversion + content hash\nاپ و PDF از همان شناسه", color="#E9B85C", fillcolor="#2A2418", fontcolor="#FFE9B9", style="rounded,dashed,filled"];
    private_pdf_qr [label="PDF خصوصی کامل + QR نسخه‌دار در صفحهٔ آخر\nQR فقط reference قابل‌ابطال است؛\nبا QR حضور باشگاه فرق دارد", color="#E9B85C", fillcolor="#2A2418", fontcolor="#FFE9B9", style="rounded,dashed,filled", URL="athlete-jp7-program-qr-flow-v6-2026-11-23.svg", target="_blank"];
    cycle_metrics [label="Planned vs performed + سنجش قابل‌مقایسه\nscorecard جزءبه‌جزء؛ بدون ادعای causality\nچرخهٔ بعد پس از تأیید مربی", color="#E9B85C", fillcolor="#2A2418", fontcolor="#FFE9B9", style="rounded,dashed,filled"];
    { rank=same; q_forms; source_gate; composer; versioned_program; private_pdf_qr; cycle_metrics; }
    q_forms -> source_gate -> composer -> versioned_program -> private_pdf_qr -> cycle_metrics -> q_forms [style=dashed, color="#E9B85C", label="چرخهٔ هدف"];
  }
  composer -> svc_training [style=dashed, color="#E9B85C", label="پس از طراحی/تأیید/پیاده‌سازی جدا", constraint=false];

  subgraph cluster_legend {
    label="راهنمای وضعیت شواهد"; color="#52657A"; fontcolor="#C6D2DF"; style="rounded,dashed";
    legend_current [label="کد/قرارداد جاری قابل‌ردیابی", color="#51D6A0", fillcolor="#132B22"];
    legend_conditional [label="وابسته به config یا بدون E2E / production proof", color="#6AB7E8", fillcolor="#172739"];
    legend_gap [label="گپ/رفتار ناقص یا endpoint مسدود", color="#F08A93", fillcolor="#321C24", fontcolor="#FFE3E6"];
    legend_target [label="طرح/هدف/تصمیمی که نباید اجراشده فرض شود", color="#E9B85C", fillcolor="#2A2418", fontcolor="#FFE9B9", style="rounded,dashed,filled"];
    { rank=same; legend_current; legend_conditional; legend_gap; legend_target; }
    legend_current -> legend_conditional -> legend_gap -> legend_target [style=invis, weight=20];
  }

  route_catalog [label="پیوست مکانیکی API\n۱۶۳ operation · ۱۴۱ path template\nmethod · guards · scopes · roles", color="#6AB7E8", fillcolor="#172739", URL="../../../mp-app/backend/api/routes.json", target="_blank"];
  references [label="نقشه‌های جزئی‌تر موجود\nClient · Studio · UI/UX · Transactions\nچرخهٔ ورزشکار/JP7/QR", color="#6AB7E8", fillcolor="#172739", URL="README.md", target="_blank"];
  { rank=same; route_catalog; references; }
  route_catalog -> references [style=invis, weight=15];
  route_catalog -> route_identity [style=dotted, color="#6AB7E8", arrowhead=none, constraint=false];
}
