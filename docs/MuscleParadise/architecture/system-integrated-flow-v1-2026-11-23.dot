    { rank=same; ux_member_auth; ux_member_training; ux_member_health; ux_member_attendance; ux_member_money; ux_staff_ops; ux_staff_program; ux_staff_finance; ux_staff_admin; }
    ux_member_auth -> ux_member_training -> ux_member_health -> ux_member_attendance -> ux_member_money -> ux_staff_ops -> ux_staff_program -> ux_staff_finance -> ux_staff_admin [style=invis, weight=30];
  }
