  sqlite_store [label="SQLAlchemy · SQLite پیش‌فرض در snapshot\nدادهٔ دامنه؛ PostgreSQL فقط هدف مهاجرتِ مشروط", color="#51D6A0", fillcolor="#132B22"];
  private_store [label="فایل خصوصی فیش/مدرک\nخارج از static؛ دسترسی کنترل‌شده\nمحتوای رسیدها در این کار باز نشده", color="#6AB7E8", fillcolor="#172739"];
  runtime_jobs [label="Valkey/cache و APScheduler/outbox\nتعریف/تست کد ≠ worker فعال در startup\nتک‌اجرا، retry، monitor و backup باید ثابت شوند", color="#E9B85C", fillcolor="#2A2418", fontcolor="#FFE9B9"];
  { rank=same; sqlite_store; private_store; runtime_jobs; }
