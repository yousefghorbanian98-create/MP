  svc_identity -> sms [style=dashed, color="#E9B85C", label="ارسال OTP وابسته به env"];
  svc_finance -> bank [style=dashed, color="#E9B85C", label="تطبیق انسانی"];
  svc_training -> ai_optional [style=dashed, color="#E9B85C", label="اگر runtime پیکربندی شود"];
  sqlite_store -> operations [style=dashed, color="#6AB7E8", label="استقرار و backup وابسته به محیط"];

  subgraph cluster_owner_open {
    label="تصمیم‌های مصوب محصول / جزئیات باز برای تأیید مالک"; color="#E9B85C"; fontcolor="#FFE2A3"; style="rounded,dashed";
    confirmed_platform [label="انتشار اول طبق TODO مالک\nAndroid عضو + پنل وب کارکنان\nسرور محلی باشگاه + ورودی HTTPS؛\nدامنه/میزبانی/restore هنوز باید آزموده شود", color="#E9B85C", fillcolor="#2A2418", fontcolor="#FFE9B9", style="rounded,dashed,filled", URL="../TODO-CLOUD-FINANCE-ACCESS.md", target="_blank"];
    pwa_target [label="PWA یکپارچه / access target\nطرح آینده، نه رابط جاری\nبدون تصمیم مهاجرت/حذف Android و Studio", color="#E9B85C", fillcolor="#2A2418", fontcolor="#FFE9B9", style="rounded,dashed,filled", URL="muscle-paradise-final-pwa-access-flow-v1-2026-11-23.md", target="_blank"];
    role_target [label="مدل نقش هدف سه‌گانه در طرح قدیمی\nدر برابر شش role جاری؛ migration/route matrix\nو سیاست grant هنوز باید تکمیل شود", color="#E9B85C", fillcolor="#2A2418", fontcolor="#FFE9B9", style="rounded,dashed,filled"];
    privacy_decision [label="عکس پیشرفت بدن\nتصمیم مالک: عضو مدت نگهداری را انتخاب کند\nTODO انتشار اول: ذخیرهٔ این عکس خارج از scope\nاین‌ها هم‌معنی/اجراشده نیستند", color="#E9B85C", fillcolor="#2A2418", fontcolor="#FFE9B9", style="rounded,dashed,filled"];
    { rank=same; confirmed_platform; pwa_target; role_target; privacy_decision; }
