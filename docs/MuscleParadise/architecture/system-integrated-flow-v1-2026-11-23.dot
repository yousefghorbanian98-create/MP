    data_nutrition [label="NutritionPlan · MealItem\nFoodLog · BodyWeightLog", color="#51D6A0", fillcolor="#132B22"];
    data_finance [label="Payment · WalletTransaction · LedgerEntry\nExpense · ExpenseRevision · ReportRun\nProduct/cart/order models", color="#51D6A0", fillcolor="#132B22"];
    data_comms [label="Conversation · Message · Notification\nOutboxEvent · InboxMessage\nAuditLog · FeatureFlag · grants", color="#51D6A0", fillcolor="#132B22"];
    { rank=same; data_identity; data_training; data_assessment; data_attendance; data_nutrition; data_finance; data_comms; }
    data_identity -> data_training -> data_assessment -> data_attendance -> data_nutrition -> data_finance -> data_comms [style=invis, weight=30];
