  staff -> studio_app;
  kiosk_operator -> kiosk_ui;
  staff -> kiosk_ui [label="نقش پذیرش"];

  subgraph cluster_ux {
    label="۳ · صفحه‌ها و intentهای اصلی در UI"; color="#5EA8D2"; fontcolor="#8CCCF0"; style="rounded";
    ux_member_auth [label="عضو · OTP / نشست / پروفایل\nRestore و خروج؛ پروفایل از `/members/me`"];
    ux_member_training [label="عضو · خانه / Intake / امروز / بازخورد\nثبت تیک تمرین محلی؛ feedback درخواست جدا", URL="member-studio-dataflow-v1-2026-11-23.md", target="_blank"];
    ux_member_health [label="عضو · ارزیابی / پیشرفت / تغذیه\nدادهٔ ناموجود ≠ صفر؛ plan ≠ food log", URL="member-studio-dataflow-v1-2026-11-23.md", target="_blank"];
    ux_member_attendance [label="عضو · کلاس / رزرو / QR\nظرفیت و صف؛ QR کوتاه‌عمر برای اسکن", URL="member-studio-dataflow-v1-2026-11-23.md", target="_blank"];
    ux_member_money [label="عضو · کیف‌پول / پرداخت / فروشگاه / چت\nنسخهٔ اول: پرداخت دستی؛ فروشگاه نمایشی", URL="member-studio-dataflow-v1-2026-11-23.md", target="_blank"];
    ux_staff_ops [label="Studio · Dashboard / Members / Analytics\nKPI و feed از API؛ انتخاب عضو مشترک", URL="member-studio-dataflow-v1-2026-11-23.md", target="_blank"];
    ux_staff_program [label="Studio · Programs / Assessment / Nutrition\nصف و بازبینی؛ رد برنامه فعلاً `window.prompt`", URL="member-studio-dataflow-v1-2026-11-23.md", target="_blank"];
    ux_staff_finance [label="Studio · Finance / Expenses\nفیش، مجوز خواندن/نوشتن، گزارش دوره‌ای", URL="transaction-findings-flow-v1-2026-11-23.svg", target="_blank"];
