digraph MuscleParadiseIntegratedSystemV1 {
  graph [
    rankdir=TB, bgcolor="#0B0F14", pad="0.30", nodesep="0.28", ranksep="0.44",
    splines=polyline, compound=true, newrank=true, concentrate=true, dpi=150,
    fontname="DejaVu Sans", fontsize=24, fontcolor="#F3F6F8",
    label="Muscle Paradise · نقشهٔ یکپارچهٔ سامانه\nکاربر → اپ و UI → قرارداد/API و دسترسی → route/service → داده و عملیات\nخط پیوسته = وضعیت قابل‌ردیابی | کهربایی خط‌چین = هدف/تصمیم باز | نمودار به‌تنهایی شاهد E2E نیست",
    labelloc="t", labeljust="c"
  ];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
        color="#426174", fillcolor="#13222B", fontcolor="#F3F6F8",
        penwidth=1.2, margin="0.13,0.08"];
  edge [fontname="DejaVu Sans", fontsize=8, color="#7F98A5", fontcolor="#D6E2E8",
        penwidth=0.85, arrowsize=0.60];

  subgraph cluster_roles {
    label="۱ · نقش‌ها و بازیگران جاری"; color="#5EA8D2"; fontcolor="#8CCCF0"; style="rounded";
    member [label="عضو / ورزشکار\nrole جاری: `member`", color="#51D6A0", fillcolor="#132B22"];
    staff [label="کادر / مدیر\n`coach · reception · manager\nadmin · super_admin`", color="#51D6A0", fillcolor="#132B22"];
    kiosk_operator [label="پذیرش / دستگاه اسکن\nمحیط فیزیکی جدا از اپ عضو", color="#6AB7E8", fillcolor="#172739"];
    { rank=same; member; staff; kiosk_operator; }
    member -> staff -> kiosk_operator [style=invis, weight=30];
  }

  subgraph cluster_apps {
    label="۲ · سطح محصول و کلاینت‌های موجود"; color="#5EA8D2"; fontcolor="#8CCCF0"; style="rounded";
    client_app [label="MP Client · Flutter / Android\nاپ عضو · RTL · API client\nقفل دستگاه برای ارائهٔ QR محلی", color="#51D6A0", fillcolor="#132B22", URL="member-studio-dataflow-v1-2026-11-23.md", target="_blank"];
    studio_app [label="MP Studio · React / TypeScript / Vite\nپنل وب کادر · OTP/session\nنقش/مجوز + توکن‌های UI · reduced motion", color="#51D6A0", fillcolor="#132B22", URL="member-studio-dataflow-v1-2026-11-23.md", target="_blank"];
    kiosk_ui [label="اسکن/حضور پذیرش\nدستگاه و استقرار باید جدا آزموده شوند", color="#6AB7E8", fillcolor="#172739"];
    { rank=same; client_app; studio_app; kiosk_ui; }
    client_app -> studio_app -> kiosk_ui [style=invis, weight=30];
  }
