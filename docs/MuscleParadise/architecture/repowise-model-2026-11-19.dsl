# Structurizr DSL model for MP, generated by Repowise.
#
# Regenerating overwrites this file — do not hand-edit it.
# It holds the model only; your views, styles and docs stay in
# your own workspace.dsl. Include it from inside the workspace
# block — the parser rejects an include that sits outside one:
#
#     workspace "your name" {
#         !include repowise-model.dsl
#
#         views {
#             ...
#         }
#     }
#
# !include is resolved from disk, so this pair needs Structurizr Lite
# or the Structurizr CLI. The web editor at structurizr.com cannot
# follow it — export with --standalone for a file to paste there.
#
# Suggested reading order:
#   1. README.md — README.md
#      Start here for the end-to-end picture before diving into the code.
#   2. main.cjs — mp-app/studio/electron/main.cjs
#      An entry point — execution and imports fan out from here.
#   3. main.py — mp-app/backend/app/main.py
#      An entry point — execution and imports fan out from here.
#   4. main.tsx — mp-app/studio/src/main.tsx
#      An entry point — execution and imports fan out from here.
#   5. App.tsx — mp-app/studio/src/App.tsx
#      An entry point — execution and imports fan out from here.
#   6. main.dart — mp-app/client/lib/main.dart
#      An entry point — execution and imports fan out from here.
#   7. import_exercise_catalog.py — mp-app/backend/scripts/import_exercise_catalog.py
#      The Docs & Tooling layer's anchor — its most depended-on file.
#   8. base.py — mp-app/backend/db/base.py
#      Directly used by the entry points above; a core collaborator.
#   9. glass_card.dart — mp-app/client/lib/shared/widgets/glass_card.dart
#      The Utility layer's anchor — its most depended-on file.
#   10. api.py — mp-app/backend/api/v1/api.py
#      The API layer's anchor — its most depended-on file.
#   11. JalaliDateField.tsx — mp-app/studio/src/components/ui/JalaliDateField.tsx
#      The UI layer's anchor — its most depended-on file.
#   12. conftest.py — mp-app/backend/tests/conftest.py
#      The test suite — how the system's behavior is verified.
#
model {
    person_user = person "User" "Uses the system"

    sys_MP = softwareSystem "MP" "> 🚧 **وضعیت پروژه: توسعهٔ فعال، نه آمادهٔ انتشار.** کارکردهای اصلی، امنیت، گیت‌های CI و Android و آزمون دستگاه باید برای نسخهٔ انتشار اثبات شوند. هدف و تصمیم‌ها · برنامهٔ میکرولوپ و QA · هندآف کامل > > 🧭 **برای سازندهٔ بعدی:** ابتدا پیش‌نیازها و راهنمای ادامه با RepoWise را بخوانید؛ index محلی ابزار و فایل‌های محرمانه در Git وجود ندارند و گراف جای کد و آزمون نیست. > > 🔒 **مجوز:** عمومی‌بودن کد به معنی متن‌بازبودن آن نیست. این پروژه تحت مجوز اختصاصی است؛ LICENSE را ببینید. > > 💳 **هدف پرداخت انتشار اول:** کارت‌به‌کارت با فیش خصوصی، تطبیق انسانی با بانک و فعال‌سازی خودکار اشتراک پس از تأیید. طرح و گیت‌های M113 و شواهد REA هدف را توضیح می‌دهند؛ policy مستقل و تست محلی نوشته شده، ولی اتصال کامل، آپلود خصوصی و تأیید بانکی هنوز اثبات نشده‌اند. `card` موجود همچنان کارت‌خوان حضوری است." {
