# Structurizr DSL model for repo-copy, generated by Repowise.
#
# A complete workspace: open it as-is in Structurizr Lite, the
# Structurizr CLI, or by pasting it into structurizr.com.
#
# This file is yours now — edit the views and styles below freely.
# Re-exporting overwrites the whole file, so once you have made it
# your own, switch to the model fragment instead and keep your
# presentation in a workspace.dsl the generator never touches:
#
#     repowise export --format structurizr
#
# Suggested reading order:
#   1. README.md — README.md
#      Start here for the end-to-end picture before diving into the code.
#   2. main.cjs — mp-app/studio/electron/main.cjs
#      An entry point — execution and imports fan out from here.
#   3. main.py — mp-app/backend/app/main.py
#      An entry point — execution and imports fan out from here.
#   4. main.tsx — mp-app/studio/src/main.tsx
#      An entry point — execution and imports fan out from here.
#   5. App.tsx — mp-app/studio/src/App.tsx
#      An entry point — execution and imports fan out from here.
#   6. main.dart — mp-app/client/lib/main.dart
#      An entry point — execution and imports fan out from here.
#   7. import_exercise_catalog.py — mp-app/backend/scripts/import_exercise_catalog.py
#      The Docs & Tooling layer's anchor — its most depended-on file.
#   8. base.py — mp-app/backend/db/base.py
#      Directly used by the entry points above; a core collaborator.
#   9. glass_card.dart — mp-app/client/lib/shared/widgets/glass_card.dart
#      The Utility layer's anchor — its most depended-on file.
#   10. api.py — mp-app/backend/api/v1/api.py
#      The API layer's anchor — its most depended-on file.
#   11. JalaliDateField.tsx — mp-app/studio/src/components/ui/JalaliDateField.tsx
#      The UI layer's anchor — its most depended-on file.
#   12. conftest.py — mp-app/backend/tests/conftest.py
#      The test suite — how the system's behavior is verified.
#
workspace "repo-copy" {
    model {
        person_user = person "User" "Uses the system"

        sys_repo_copy = softwareSystem "repo-copy" "> 🚧 **وضعیت پروژه: توسعهٔ فعال، نه آمادهٔ انتشار.** کارکردهای اصلی، امنیت، گیت‌های CI و Android و آزمون دستگاه باید برای نسخهٔ انتشار اثبات شوند. هدف و تصمیم‌ها · برنامهٔ میکرولوپ و QA · هندآف کامل > > 🧭 **برای سازندهٔ بعدی:** ابتدا پیش‌نیازها و راهنمای ادامه با RepoWise را بخوانید؛ index محلی ابزار و فایل‌های محرمانه در Git وجود ندارند و گراف جای کد و آزمون نیست. > > 🔒 **مجوز:** عمومی‌بودن کد به معنی متن‌بازبودن آن نیست. این پروژه تحت مجوز اختصاصی است؛ LICENSE را ببینید. > > 💳 **هدف پرداخت انتشار اول:** کارت‌به‌کارت با فیش خصوصی، تطبیق انسانی با بانک و فعال‌سازی خودکار اشتراک پس از تأیید. طرح و گیت‌های M113 و شواهد REA هدف را توضیح می‌دهند؛ policy مستقل و تست محلی نوشته شده، ولی اتصال کامل، آپلود خصوصی و تأیید بانکی هنوز اثبات نشده‌اند. `card` موجود همچنان کارت‌خوان حضوری است." {
            pkg_mp_app_backend = container "mp-backend" "383 files, 2933 symbols" "python" {
                tags "Dead" "Layer: API" "Layer: Application" "Layer: Data" "Layer: Docs & Tooling" "Layer: Test"
                properties {
                    "repowise.deadFiles" "3"
                    "repowise.hotspots" "0"
                    "repowise.layers" "API, Application, Data, Docs & Tooling, Test"
                }
            }

            pkg_mp_app_studio = container "mp-studio" "111 files, 544 symbols" "typescript" {
                tags "Dead" "Layer: Application" "Layer: Data" "Layer: Service" "Layer: Test" "Layer: UI"
                properties {
                    "repowise.deadFiles" "2"
                    "repowise.hotspots" "0"
                    "repowise.layers" "Application, Data, Service, Test, UI"
                }
            }

            pkg_tools_mermaid_check = container "mp-mermaid-check" "2 files, 6 symbols" "javascript" {
                tags "Layer: Utility"
                properties {
                    "repowise.deadFiles" "0"
                    "repowise.hotspots" "0"
                    "repowise.layers" "Utility"
                }
            }
        }

        ext_ant_design_cssinjs = softwareSystem "Cssinjs" "library · npm · ^1.24.0" {
            tags "External"
        }
        ext_ant_design_icons = softwareSystem "Icons" "library · npm · ^5.6.1" {
            tags "External"
        }
        ext_vitejs_plugin_react = softwareSystem "Plugin React" "library · npm · ^4.3.3" {
            tags "External"
        }
        ext_alembic = softwareSystem "Alembic" "tool · pypi · >=1.13" {
            tags "External"
        }
        ext_antd = softwareSystem "Antd" "library · npm · ^5.29.3" {
            tags "External"
        }
        ext_casbin = softwareSystem "Casbin" "library · pypi · >=1.30" {
            tags "External"
        }
        ext_fastapi = softwareSystem "Fastapi" "framework · pypi · >=0.110" {
            tags "External"
        }
        ext_framer_motion = softwareSystem "Framer Motion" "library · npm · ^11.11.0" {
            tags "External"
        }
        ext_httpx = softwareSystem "Httpx" "library · pypi · >=0.27" {
            tags "External"
        }
        ext_jsdom = softwareSystem "Jsdom" "library · npm · ^25.0.1" {
            tags "External"
        }
        ext_mermaid = softwareSystem "Mermaid" "library · npm · ^11.4.1" {
            tags "External"
        }
        ext_pydantic = softwareSystem "Pydantic" "library · pypi · >=2.6" {
            tags "External"
        }
        ext_react = softwareSystem "React" "framework · npm · ^18.3.1" {
            tags "External"
        }
        ext_react_dom = softwareSystem "React Dom" "library · npm · ^18.3.1" {
            tags "External"
        }
        ext_react_multi_date_picker = softwareSystem "React Multi Date Picker" "library · npm · ^4.5.2" {
            tags "External"
        }
        ext_recharts = softwareSystem "Recharts" "library · npm · ^2.13.0" {
            tags "External"
        }
        ext_redis = softwareSystem "Redis" "service · pypi · >=5,<8" {
            tags "External"
        }
        ext_slowapi = softwareSystem "Slowapi" "library · pypi · >=0.1.10,<0.2" {
            tags "External"
        }
        ext_sqlalchemy = softwareSystem "Sqlalchemy" "service · pypi · >=2.0" {
            tags "External"
        }
        ext_structlog = softwareSystem "Structlog" "library · pypi · >=24.1" {
            tags "External"
        }
        ext_vite = softwareSystem "Vite" "tool · npm · ^5.4.10" {
            tags "External"
        }
        ext_vitest = softwareSystem "Vitest" "tool · npm · ^3.2.7" {
            tags "External"
        }
        ext_zustand = softwareSystem "Zustand" "library · npm · ^5.0.0" {
            tags "External"
        }

        # Relationships
        person_user -> sys_repo_copy "uses"
        pkg_mp_app_backend -> ext_alembic "imports" {
            tags "Moderate"
        }
        pkg_mp_app_backend -> ext_casbin "imports" {
            tags "Loose"
        }
        pkg_mp_app_backend -> ext_fastapi "imports" {
            tags "Moderate"
        }
        pkg_mp_app_backend -> ext_httpx "imports" {
            tags "Loose"
        }
        pkg_mp_app_backend -> ext_pydantic "imports" {
            tags "Moderate"
        }
        pkg_mp_app_backend -> ext_redis "imports" {
            tags "Loose"
        }
        pkg_mp_app_backend -> ext_slowapi "imports" {
            tags "Loose"
        }
        pkg_mp_app_backend -> ext_sqlalchemy "imports" {
            tags "Tight"
        }
        pkg_mp_app_backend -> ext_structlog "imports" {
            tags "Loose"
        }
        pkg_mp_app_studio -> ext_ant_design_cssinjs "imports" {
            tags "Loose"
        }
        pkg_mp_app_studio -> ext_ant_design_icons "imports" {
            tags "Loose"
        }
        pkg_mp_app_studio -> ext_antd "imports" {
            tags "Moderate"
        }
        pkg_mp_app_studio -> ext_framer_motion "imports" {
            tags "Moderate"
        }
        pkg_mp_app_studio -> ext_react "imports" {
            tags "Moderate"
        }
        pkg_mp_app_studio -> ext_react_dom "imports" {
            tags "Loose"
        }
        pkg_mp_app_studio -> ext_react_multi_date_picker "imports" {
            tags "Loose"
        }
        pkg_mp_app_studio -> ext_recharts "imports" {
            tags "Loose"
        }
        pkg_mp_app_studio -> ext_vite "imports" {
            tags "Loose"
        }
        pkg_mp_app_studio -> ext_vitejs_plugin_react "imports" {
            tags "Loose"
        }
        pkg_mp_app_studio -> ext_vitest "imports" {
            tags "Loose"
        }
        pkg_mp_app_studio -> ext_zustand "imports" {
            tags "Loose"
        }
        pkg_tools_mermaid_check -> ext_jsdom "imports" {
            tags "Loose"
        }
        pkg_tools_mermaid_check -> ext_mermaid "imports" {
            tags "Loose"
        }
    }

    views {
        systemContext sys_repo_copy "SystemContext" {
            include *
            exclude "element.tag==External"
            autolayout lr
        }

        container sys_repo_copy "Containers" {
            include *
            autolayout lr
        }

        container sys_repo_copy "layer_API" "API" {
            include "element.tag==Layer: API"
            autolayout lr
        }

        container sys_repo_copy "layer_Application" "Application" {
            include "element.tag==Layer: Application"
            autolayout lr
        }

        container sys_repo_copy "layer_Data" "Data" {
            include "element.tag==Layer: Data"
            autolayout lr
        }

        container sys_repo_copy "layer_Docs_Tooling" "Docs & Tooling" {
            include "element.tag==Layer: Docs & Tooling"
            autolayout lr
        }

        container sys_repo_copy "layer_Service" "Service" {
            include "element.tag==Layer: Service"
            autolayout lr
        }

        container sys_repo_copy "layer_Test" "Test" {
            include "element.tag==Layer: Test"
            autolayout lr
        }

        container sys_repo_copy "layer_UI" "UI" {
            include "element.tag==Layer: UI"
            autolayout lr
        }

        container sys_repo_copy "layer_Utility" "Utility" {
            include "element.tag==Layer: Utility"
            autolayout lr
        }

        styles {
            element "External" {
                background #999999
                color #ffffff
            }
            element "Hotspot" {
                background #b5432f
                color #ffffff
            }
            element "Dead" {
                background #6b6b6b
                color #ffffff
            }
            relationship "Tight" {
                thickness 4
            }
            relationship "Loose" {
                style dashed
            }
        }
    }
}
