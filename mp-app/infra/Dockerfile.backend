# Muscle Paradise — ایمیج بک‌اند (M10/M11)
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

COPY pyproject.toml ./
COPY app ./app
COPY api ./api
COPY modules ./modules
COPY db ./db
COPY security ./security
COPY jobs ./jobs
COPY cache ./cache

RUN pip install --no-cache-dir .

EXPOSE 8751
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8751"]
