# Production Compose template — copy to mp-app/deploy/.env and replace every placeholder.
# Keep the real .env out of Git and chmod 600 it. This template is intentionally
# incomplete: the application must refuse to start until secrets/providers are set.
MP_ENVIRONMENT=production
MP_DATABASE_URL=sqlite:////data/mp.db
# Use a reviewed full commit SHA; GHCR tags can be overwritten unless registry access prevents it.
IMAGE_OWNER=
IMAGE_TAG=
MP_SECRET_KEY=
# Base64 encoding of exactly 32 random bytes; do not reuse MP_SECRET_KEY.
MP_BIOMETRIC_KEY=
# Inside the Compose network. Do not use localhost from the backend container.
MP_VALKEY_URL=redis://valkey:6379/0
# Replace with the HTTPS origin actually serving Studio/client web content.
MP_CORS_ORIGINS=

# OTP delivery — choose a real, configured provider; `dev` is forbidden in production.
MP_SMS_PROVIDER=kavenegar
MP_SMS_API_URL=
MP_SMS_API_KEY=
MP_SMS_USERNAME=
MP_SMS_PASSWORD=
MP_SMS_ORIGINATOR=

# Live gateway is required in production; obtain the merchant ID from the operator.
MP_PAYMENT_GATEWAY=zarinpal
MP_ZARINPAL_MERCHANT_ID=
MP_PAYMENT_SANDBOX=false

MP_ACCESS_TOKEN_MINUTES=30
MP_REFRESH_TOKEN_DAYS=14
MP_OTP_TTL_SECONDS=120
MP_OTP_MAX_ATTEMPTS=5
MP_OTP_RATE_LIMIT=10/minute
MP_OTP_BURST_LIMIT=3/second
MP_LOGIN_RATE_LIMIT=10/minute
