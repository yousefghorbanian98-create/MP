# Muscle Paradise — نمونهٔ متغیرهای محیطی (کپی به .env و مقداردهی)
# هرگز .env واقعی را commit نکنید (در .gitignore است)

MP_ENVIRONMENT=production
MP_DATABASE_URL=sqlite:///./mp.db
MP_SECRET_KEY=change-me-to-a-long-random-string
# کلید رمزنگاری بیومتریک: base64 از ۳۲ بایت تصادفی
# نمونه ساخت: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
MP_BIOMETRIC_KEY=
MP_ACCESS_TOKEN_MINUTES=30
MP_REFRESH_TOKEN_DAYS=14
MP_OTP_TTL_SECONDS=120
MP_OTP_MAX_ATTEMPTS=5
MP_OTP_RATE_LIMIT=5/minute
MP_LOGIN_RATE_LIMIT=10/minute
