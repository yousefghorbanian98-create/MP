# Production Compose template — copy to mp-app/deploy/.env and replace every placeholder.
# Keep the real .env out of Git and chmod 600 it. This template is intentionally
# incomplete: the application must refuse to start until secrets/providers are set.
MP_ENVIRONMENT=production
MP_DATABASE_URL=sqlite:////data/mp.db
# Use a reviewed full commit SHA; GHCR tags can be overwritten unless registry access prevents it.
IMAGE_OWNER=
IMAGE_TAG=
MP_SECRET_KEY=
# Base64 encoding of exactly 32 random bytes; do not reuse MP_SECRET_KEY.
MP_BIOMETRIC_KEY=
# Inside the Compose network. Do not use localhost from the backend container.
MP_VALKEY_URL=redis://valkey:6379/0
# Replace with the HTTPS origin actually serving Studio/client web content.
MP_CORS_ORIGINS=
# Generate a high-entropy Bearer token; this same value is required by backend and Prometheus.
MP_METRICS_TOKEN=
# Stable addresses for the Compose network; choose a non-overlapping subnet for this host.
MP_COMPOSE_SUBNET=172.30.0.0/24
MP_BACKEND_IP=172.30.0.2
MP_STUDIO_IP=172.30.0.3
MP_CADDY_IP=172.30.0.4
# `deploy` only: upstream TLS proxy as seen by Studio Nginx; one IP/CIDR. Required there.
STUDIO_TRUSTED_PROXY=
# Set to MP_STUDIO_IP for `deploy`, or MP_CADDY_IP for `infra`; never use `*`/broad ranges.
MP_TRUSTED_PROXIES=

# OTP delivery — choose a real, configured provider; `dev` is forbidden in production.
MP_SMS_PROVIDER=kavenegar
MP_SMS_API_URL=
MP_SMS_API_KEY=
MP_SMS_USERNAME=
MP_SMS_PASSWORD=
MP_SMS_ORIGINATOR=

# Live gateway is required in production; obtain the merchant ID from the operator.
# manual = بدون درگاه اینترنتی (تصمیم مالک ۲۰۲۶-۱۱-۱۹)
MP_PAYMENT_GATEWAY=manual
MP_PAYMENT_SANDBOX=false

MP_ACCESS_TOKEN_MINUTES=30
MP_REFRESH_TOKEN_DAYS=14
MP_OTP_TTL_SECONDS=120
MP_OTP_MAX_ATTEMPTS=5
MP_OTP_RATE_LIMIT=10/minute
MP_OTP_BURST_LIMIT=3/second
MP_LOGIN_RATE_LIMIT=10/minute

# ── فروشگاه (فاز ۲، تصمیم مالک ۲۰۲۶-۱۱-۱۹) ──
# خرید درون‌برنامه‌ای بسته است؛ خرید حضوری در ساعات کاری باشگاه انجام می‌شود.
# این پرچم فقط برای تست موتور پول روی ماشین توسعه روشن می‌شود.
MP_SHOP_ONLINE_PURCHASE_ENABLED=false
MP_SHOP_TIMEZONE=Asia/Tehran
MP_SHOP_OPEN_HOUR=7
MP_SHOP_CLOSE_HOUR=23
# روزهای تعطیل هفتگی با کاما؛ ۰=دوشنبه … ۶=یکشنبه
MP_SHOP_CLOSED_WEEKDAYS=
