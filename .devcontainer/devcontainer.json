{
  "name": "Muscle Paradise Flutter",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "MP API" },
    "5173": { "label": "Studio Vite" }
  },
  "containerEnv": {
    "FLUTTER_HOME": "/home/vscode/sdk/flutter",
    "PUB_CACHE": "/home/vscode/.pub-cache",
    "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "dart.flutterSdkPath": "/home/vscode/sdk/flutter",
        "dart.previewFlutterUiGuides": true
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
